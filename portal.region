<!doctype html>
<html>
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">

    <!-- include system scripts, page meta, and header code injection -->
    {squarespace-headers}
    
     <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css"
    />
        <script src="https://cdn.tailwindcss.com"></script>

        <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js" ></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-scrollTo/2.1.3/jquery.scrollTo.min.js" ></script>
        <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

        <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />
  
        <style>
           .profile {
              margin-right: 10px;
              display: inline-flex;
              flex-direction: column;
              align-items: center;
              overflow: hidden;
              padding: 1rem;
            }

        </style>
  </head>
  <body class="portal-body" id="{squarespace.page-id}" class="{squarespace.page-classes}">
        {@|apply loader.block}
        {@|apply nav.block}
      
          <div class="site-container">
              <div class="splash-ct">
                  <div class="text-stack">
                    <h3 class="fadeIn">
                      GEMS PORTAL
                    </h3>
                    <h1 class="fadeIn">
                          BECOME A GEM<br>
                          AND START A<br>
                          LEGACY
                        {#  <span class="colorChange_about">TOGETHER.</span>  }
                    </h1>
                    <p class="fadeIn">
                        <b >
                        Learn about the R.E.A.L GEMS organization and how we plan
                        to impact lives of young women.
                        </b>
                    </p>

                    {@|apply scroll_icon.block}
                  </div>
              </div>
          </div>

          <div class="dashboard-wrapper relative w-full h-auto bg-white p-5">
            <div class="dashboard mt-5  w-full h-screen m-auto overflow-hidden flex flex-row items-start justify-evenly gap-y-0 gap-x-3 grid grid-cols-7 grid-rows-1">
              {#  left  }
                <div class="dashboard-left  col-start-1 col-span-1 row-1">
                 
                </div>

                  {#  right  }
                <div class="dashboard-right rounded-lg col-start-6 col-span-2 row-1">
                    <div style="min-height: 500px; z-index: 1; " class="overflow-hidden relative rounded-lg">
                        <div style="height: fit-content;" class="absolute left-0 right-0 bottom-0 p-2 m-auto w-[90%] z-20 ">
                            <span class="my-2 bg-green-100 text-green-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded-full">Student Athelete</span>

                            <h1 class="text-white font-bold text-7xl">Jackie</h1>
                            <p class="my-2 text-white text-justify text-sm">Lorem ipsum dolor sit amet, consectetur adipiscing elit, 
                            sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. 
                            Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris 
                            nisi ut aliquip ex ea commodo consequat.
                            </p>
                        </div>

                        <div style="z-index: 1;" class="absolute top-0  w-full h-full">
                          <div class="overlay "></div>
                          <img class="h-auto w-full" src="assets/student-9.jpeg" alt="">
                        </div>
                    </div>
{#  
                    <div style="min-height: 300px;" class="z-20 -mt-64 m-auto w-4/5 h-full shadow-lg rounded-lg">
                        <p>test</p>
                    </div>  }
                </div>

              {#  center  }
                <div class="dashboard-center rounded-lg h-screen overflow-y-auto  col-start-2 col-span-4 row-1">
                  <section class="w-fit-content bg-gray-100 p-4">
                    <h3 class="ms-0 text-xl font-bold text-purple-800">
                      Current
                    </h3>
                    <div class="profile-ct block ms-0 my-3 whitespace-nowrap">
                        <div class="profile ">
                            <img class="w-24 h-24 p-1 rounded-full ring-2 ring-gray-300 dark:ring-gray-500" src="assets/pro-1.png" alt="Bordered avatar">
                            <p class="text-gray-500 font-bold mt-2">Jane</p>
                        </div>
                        <div class="profile ">
                            <img class="w-24 h-24 p-1 rounded-full ring-2 ring-gray-300 dark:ring-gray-500" src="assets/pro-2.png" alt="Bordered avatar">
                            <p class="text-gray-500 font-bold mt-2">Beth</p>
                        </div>
                        <div class="profile ">
                            <img class="w-24 h-24 p-1 rounded-full ring-2 ring-gray-300 dark:ring-gray-500" src="assets/pro-3.png" alt="Bordered avatar">
                            <p class="text-gray-500 font-bold mt-2">Brittany</p>
                        </div>
                        <div class="profile ">
                            <img class="w-24 h-24 p-1 rounded-full ring-2 ring-gray-300 dark:ring-gray-500" src="assets/pro-4.png" alt="Bordered avatar">
                            <p class="text-gray-500 font-bold mt-2">Jessie</p>
                        </div>
                    </div>
                  </section>

                  <section class="w-fit-content bg-gray-100 p-4">
                    <h3 class="ms-0 text-xl font-bold text-purple-800">
                      Legacy
                    </h3>
                    <div class="legacy-ct block ms-0 my-3">
                        <!-- Generated  -->
                    </div>
                  </section>
                </div>
            </div>
          </div>
  </body>

  <script type="text/javascript">
    (function() {

      var navbar = document.getElementById("nav");
      var sticky = navbar.offsetTop;

      function stickyNav() {
        if ($(".site-container").offset().top <= sticky) {
          navbar.classList.add("sticky")
          {#  $(".nav-img-ct img").attr("src", "/assets/gems-log-purple.png");  }
        } 
        
         if ($(".site-container").offset().top == 0 
         ||  $(".site-container").offset().top >= sticky) {
          navbar.classList.remove("sticky");
          $(".nav-img-ct img").attr("src", "/assets/gems-logo.png");
        }
      }

      function scrollS() {
            $(".swipe-cont h1").addClass("fadeUpDim");
            var tiemout = setTimeout(() => {
                $(".swipe-cont .swiper").addClass("fadeUp");
                $(".swipe-cont h1 span").addClass("colorChange");
            }, 3000);
        }

        function isElementInViewport(elem) {
            var $elem = $(elem);

            var scrollElem = ((navigator.userAgent.toLowerCase().indexOf('webkit') != -1) ? 'body' : 'html');
            var viewportTop = $(scrollElem).scrollTop();
            var viewportBottom = viewportTop + $(window).height();

            var elemTop = Math.round( $elem.offset().top );
            var elemBottom = elemTop + $elem.height();

            return ((elemTop < viewportBottom) && (elemBottom > viewportTop));
        }

         function animateKeyPoints() {
              var $elem = $('.what-we-do .key-points  .key-point');
              var $animateEl = $('.what-we-do .key-points  .key-point:nth-child(1)');
              var $animateEl2 = $('.what-we-do .key-points .key-point:nth-child(3)');
              
              if (isElementInViewport($elem)) {
                  $animateEl.addClass('moveIn_key1');
                  $animateEl2.addClass('moveIn_key2');
              } else {
                  {#  $elem.removeClass('start');  }
              }
        }


      $(document).ready(() => {
           const progressCircle = document.querySelector(".autoplay-progress svg");
    const progressContent = document.querySelector(".autoplay-progress span");
   
            var swiper = new Swiper('.swiper', {
              speed: 1000,
               slidesPerView: 3,
                spaceBetween: 30,
                grabCursor: true,
                stopOnLastSlide: true,
                autoplay: {
                  delay: 3000,
                  disableOnInteraction: false,
                },
                on: {
                  autoplayTimeLeft(s, time, progress) {
                    progressCircle.style.setProperty("--progress", 1 - progress);
                  }
                }
              });

            let alreadAnimated = false;

            $("body").on("scroll", function() {
                stickyNav();
                animateKeyPoints();

                    $(".facts .key-points .key-point").each((i, el)  => {
                      var top_of_element = $(el).offset().top;
                      var bottom_of_element = $(el).offset().top + $(this).outerHeight();
                      var bottom_of_screen = $(window).scrollTop() + window.innerHeight;
                      var top_of_screen = $(window).scrollTop();

                      if((bottom_of_screen > top_of_element) && (top_of_screen < bottom_of_element)){
                         {#  $(el).addClass("background")  }
                      } else {
                          {#  $('.custom-warning').hide();  }
                      }
                  })
           });

          {#  document.querySelector('video').playbackRate = .5;  }


            $(".board-ct .img-ct img").each((index, el) => {
                  $(el).on("click", () => {
                      let link = $(el).data("profile");
                   
                      $(".text-stack").fadeOut();
                    $(".board-ct").removeClass("moveUp");
                      $(".board-ct").addClass("moveDown");
                      

                      if ($(".members-ct").find(`[data-profile-link=` + link + `]`).hasClass("hide")) {
                          $(".board-ct .exit-ct").fadeIn();
                          $(".board-ct .exit-ct").addClass("show");

                           $(".members-ct").addClass("fadeUp");
                           $(".members-ct").removeClass("fadeDown");
                           
                          $(".members-ct .member").addClass("hide");
                          $(".members-ct").find(`[data-profile-link=` + link + `]`).removeClass("hide");
                          $(".members-ct").find(`[data-profile-link=` + link + `]`).addClass("show");
                      } 

                      {#  $(".members-ct").find(`[data-profile-link='2']`).removeClass("hide");
                      $(".members-ct").find(`[data-profile-link='2']`).addClass("show");  }
                  });

              })

              $(".board-ct .exit-ct").on("click", () => {
                    $(".text-stack").fadeIn();

                    $(".board-ct .exit-ct").fadeOut();
                    $(".members-ct").addClass("fadeDown");
                    $(".members-ct").removeClass("fadeUp");


                    $(".board-ct").removeClass("moveDown");
                    $(".board-ct").addClass("moveUp");
              })

                var legacyData = [ 
                {"id": 1, "name": "Sarah", "subtitle" : "MSU Graduate | Business Owner ", "testimony": "REAL GEMS was a divine blessing, offering a profound framework of servant leadership, love, and self-assurance that I hadn't realized I lacked. My experience with GEMS proved to be a resource for healing, a haven for security, and a close-knit community fostering sisterhood.", "imgSrc":"assets\/gems-legacy-1.png", "supportLink":"www.google.com"}, 
                {"id": 1, "name": "Jordyn", "subtitle" : "", "testimony": "Being A GEM has been a transformative experience for me. Having a person like Ms. Hill in my life at a young age set the foundation for me to move beyond what I thought I knew. Ms. Hill has always had an eye for seeing the hidden potential and pulling that out of you, whether you see it yourself or not. Being a member of REAL G.E.M.S challenges your perspectives, encourages personal growth, and creates a sisterhood of empowering women. Ms. Hill's genuine excitement and encouragement for the young generation of women to grow into the best versions of themselves is so pure, which is why REAL G.E.M.S will continue to flourish.", "imgSrc":"assets\/gems-legacy-2.png", "supportLink":"www.google.com"}, 
                {"id": 1, "name": "Teka", "subtitle" : "", "testimony": "REAL GEMS was something I never thought I would be able to fit into due to my confidence level at the time, until the ladies already involved showed me it's a confidence booster! Having a community of supportive women and an even more supportive mentor gave me the head start I didn't know I needed.", "imgSrc":"assets\/gems-legacy-3.png", "supportLink":"www.google.com"},
                {"id": 1, "name": "Kaylyn", "subtitle" : "", "testimony": "REAL GEMS helped me get out of my shell and made me feel good about being a part of something other than basketball. I'll always remember the foundation it gave me as a young woman and the real-life skills it taught me. I'm currently a remote Medical Coder and am proud to say that GEMS will always play a part as I excel in life and my career.", "imgSrc":"assets\/gems-legacy-4.png", "supportLink":"www.google.com"},
                {"id": 1, "name": "Allie", "subtitle" : "", "testimony": "REAL G.E.M.S. has helped me foster lifelong friendships and empowered me to be a part of organizations surrounded by other successful women. A truly unforgettable mentorship experience!", "imgSrc":"assets\/gems-legacy-5.png", "supportLink":"www.google.com"},
                {"id": 1, "name": "Colbi", "subtitle" : "", "testimony": "REAL GEMS helped lay the foundation for my walk into womanhood. It helped me to improve my self-esteem and self-worth and has helped make me into the woman I am today.", "imgSrc":"assets\/gems-legacy-6.png", "supportLink":"www.google.com"},
                {"id": 1, "name": "Jayla", "subtitle" : "", "testimony": "REAL GEMS has played such a pivotal role in who I am today and the woman I am growing into. To have learned how to love myself, treat others with kindness, and value sisterhood at such a crucial time in my adolescence, has truly empowered me to maintain success!", "imgSrc":"assets\/gems-legacy-7.png", "supportLink":"www.google.com"},
                {"id": 1, "name": "Trinity", "subtitle" : "", "testimony": "I truly believe that without REAL GEMS, I wouldn't be the woman I am today. The invaluable lessons I acquired not only motivated me to evolve into an inspirational leader but also shaped me into the strong and resilient woman I am today. GEMS instilled in me the significance of giving back to my community, the true essence of sisterhood, and the importance of maintaining high standards in all aspects of my life. Thanks to the exceptional mentorship provided by Ms. Hill, I genuinely wouldn't be the amazing woman I am today without her love and this life-changing program.", "imgSrc":"assets\/gems-legacy-8.png", "supportLink":"www.google.com"},
                {"id": 1, "name": "Amber", "subtitle" : "", "testimony": "REAL GEMS is where I built a bond with my lifelong sisters and best friends. GEMS inspired me to dream BIG and accomplish anything I set my mind to do! GEMS is a sisterhood and bond that could never be broken. It is recommended 10 out of 10!", "imgSrc":"assets\/gems-legacy-10.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Savannah", "subtitle" : "", "testimony": "REAL GEMS has impacted the woman I am today by teaching me empathy. To be able to understand and connect with other people in a soft manner truly speaks volumes to the next person. REAL GEMS taught me how to be an effective leader, a person who knows how to give clear communication and build confidence while empowering others to feel confident in themselves. Without GEMS I honestly can't say I would be the woman I am today. I find myself always going back in my memory and connecting the present time to each workshop Ms. Hill had us participate in. I know the true meaning of sisterhood because of her!", "imgSrc":"assets\/gems-legacy-11.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Taylor", "subtitle" : "", "testimony": "REAL GEMS has played a significant role in shaping the woman I've become. It provided me with one of my earliest experiences of sisterhood and served as a nurturing environment where my confidence flourished. I am eternally grateful to have been part of such a remarkable community, and GEMS will always hold a special place in my heart.", "imgSrc":"assets\/gems-legacy-12.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Chantelle", "subtitle" : "", "testimony": "REAL GEMS opened my eyes to the possibilities of me. Giving me support and love when I felt broken and unwanted.", "imgSrc":"assets\/gems-legacy-13.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Kristen", "subtitle" : "", "testimony": "Being a part of REAL GEMS has greatly impacted my life and has always stuck with me throughout adulthood. REAL GEMS taught me so many things about self-worth, etiquette, decision-making, and always striving past your greatest ambitions. The dedication and care that Ms. Hill puts into this program is truly remarkable and has a profound influence on numerous young women during such a critical period in their lives. I am forever grateful for the lessons, friendships, and guidance GEMS has brought into my life.", "imgSrc":"assets\/gems-legacy-14.jpg", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Janae'", "subtitle" : "", "testimony": "REAL G.E.M.S has played such a pivotal role in my life and will forever be a part of me. There are so many tools that I use in my life today that I learned from G.E.M.S and Ms.Hill. I still remember a lot of the lessons ranging from handling conflicts in friendships, understanding your self-worth, and touching on how certain events in history affect us as black girls. I truly am grateful to have been in a space where I was surrounded by genuine love and support as a young black girl. My time in REAL G.E.M.S has allowed me to nurture my self-esteem and grow into a beautiful well-rounded young lady.", "imgSrc":"assets\/gems-legacy-15.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Amber", "subtitle" : "", "testimony": "In GEMS I learned to believe in myself. I wasn't raised with a silver spoon nor a plastic one however, I WAS BLESSED because REAL GEMS gave me mentors, companions, sisterhood, and a GROUP. GEMS/sisterhood gave me the strength to guide me through college, a prosperous future, career, entrepreneurship, and life. I'm thriving because of my girls! GEMS!", "imgSrc":"assets\/gems-legacy-16.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Paige", "subtitle" : "", "testimony": "REAL GEMS has been part of my journey since day 1 of my joining. From exciting new experiences to life-long lessons, Ms. Hill and my sisterhood have played a pivotal role in how I show up as a woman in today's world.", "imgSrc":"assets\/gems-legacy-17.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Tomeka", "subtitle" : "", "testimony": "REAL GEMS not only gave me a sense of sisterhood but also the confidence I needed that I carried with me into the depths of womanhood. It's more than organization GEMS was the foresight into how successful I could really be.", "imgSrc":"assets\/gems-legacy-18.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Jewel", "subtitle" : "", "testimony": "REAL GEMS was a molding block that truly shaped my perspective on life; it has given me a sense of belonging and self-confidence.GEMS has inspired me to strive for success in all that I do while supporting others, leading and cultivating genuine relationships.", "imgSrc":"assets\/gems-legacy-19.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Sierra", "subtitle" : "", "testimony": "REAL GEMS solidified in me a sense of confidence, ambition, and excellence. The lessons I learned during my years of mentorship were really the framework for how I make goals and set standards for myself and others.", "imgSrc":"assets\/gems-legacy-20.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Alyse", "subtitle" : "", "testimony": "REAL GEMS allowed me to understand my potential at a young age. It instilled in me the power of confidence & community. It nurtured my creativity & expressiveness. I carry these things over into my adulthood. I am forever grateful for REAL GEMS!", "imgSrc":"assets\/gems-legacy-21.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Kristen", "subtitle" : "", "testimony": "REAL GEMS truly gave me a place to open up and begin the journey to loving myself. It's still something I'm trying to figure out but I learned so much about my worth through GEMS. GEMS felt like home at a time when I was really trying to find and feel comfortable with myself. I'll always be forever grateful to Ms.Hill and GEMS for creating such a safe and loving space for me.", "imgSrc":"assets\/gems-legacy-22.png", "supportLink":"https://www.google.com"},
                {"id": 1, "name": "Shakayla", "subtitle" : "", "testimony": "REAL GEMS has impacted me because it gave me a community of sisters that I will value forever.", "imgSrc":"assets\/gems-legacy-23.png", "supportLink":"https://www.google.com"}
                ];

              $.each(legacyData, (i, legacy) => {
                  $(".legacy-ct").append("<div class=\"legacy mb-5 bg-white p-2 rounded-lg grid grid-cols-3 grid-rows-1 gap-2\">\<div style=\"max-height: 250px;\" class=\"w-4\/5 m-auto col-start-1 col-span-1 bg-black rounded-lg overflow-hidden\"><img class=\"w-full h-auto \" src=\"" + legacy.imgSrc + "\" alt=\"\"> <\/div> <div class=\"info p-2 rounded-lg  col-start-2 col-span-2 \"><div class=\" grid grid-cols-5 gap-4  p-2 info-header \"><div class=\"col-span-2 badge-ct  m-auto ms-0 mx-2 rounded-lg bg-blue-600 p-2\"><h2 class=\"text-sm text-center text-white font-bold\">2004 CLASS<\/h2><\/div><div class=\"col-span-3  info-personal flex flex-col items-start\">\r\n                                      <h5 class=\"text-md font-bold\">" + legacy.name + "<\/h5>\r\n                                      <p class=\"text-xs font-bold text-gray-600\">" + legacy.subtitle + "<\/p>\r\n                                  <\/div>\r\n                                <\/div>\r\n                                <p class=\"my-3 text-sm text-gray-800 text-left\">"  + legacy.testimony + "<\/p>\r\n\r\n                                 <a href=\"" + legacy.supportLink + "\" class=\"cursor-pointer border border-gray-500 hover:border-blue-500 rounded-lg flex flex-row items-center justify-evenly\">\r\n                                    <div class=\"gap-4 rounded-lg p-2 grid grid-cols-6 flex flex-row items-center\">\r\n                                        <div class=\"w-10 h-10\">\r\n                                          <img class=\"w-full m-auto\" src=\"assets\/gift-icon.png\">\r\n                                        <\/div>\r\n                                        <div class=\"col-span-4 flex flex-col items-start justify-start\">\r\n                                          <p class=\"text-sm font-bold text-left text-black\">Support " + legacy.name + "'s Business<\/p>\r\n                                          <p class=\"text-xs text-left text-gray-500\">I'm raising money for my new business<\/p>\r\n                                        <\/div>\r\n                                         <div class=\"col-span-1 \">\r\n                                          <img class=\"w-full m-auto\" src=\"assets\/Paypal-logo.png\">\r\n                                        <\/div>\r\n                                    <\/div>\r\n                                 <\/a>\r\n\r\n                            <\/div>\r\n                        <\/div>");
              });

      })
    })();
  </script>
</html>

